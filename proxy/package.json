{
  "name": "@tailboot/release-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "yarn types --check && tsc --noEmit && yarn test",
    "deploy": "yarn check && wrangler deploy",
    "test": "node --test test/*.test.ts",
    "types": "wrangler types --include-runtime=false --strict-vars=false"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "wrangler": "4.127.1"
  }
}
