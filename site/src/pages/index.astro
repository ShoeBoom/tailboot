---
import { z } from "zod";
import "../styles/global.css";

const description = "Create a Tailboot live ISO with Tailscale or Tailcat SSH access.";
const socialImageUrl = new URL("/social.png", Astro.site).href;
const isoName = import.meta.env.PUBLIC_TAILBOOT_ISO_NAME ?? "tailboot.iso";
const release = import.meta.env.PUBLIC_TAILBOOT_RELEASE ?? "";
const configOffset = release
  ? z.coerce.number().int().nonnegative().parse(import.meta.env.PUBLIC_TAILBOOT_CONFIG_OFFSET)
  : undefined;
const isoUrl = release ? `https://proxy.tailboot.download/${release}` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tailboot" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site?.href} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Tailboot logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Tailboot logo" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>Tailboot</title>
  </head>
  <body class="m-0 font-sans text-[15px]/[1.5]">
    <header class="mx-auto flex w-[min(100%-2.5rem,62rem)] flex-wrap items-center justify-between gap-4 border-b border-line py-5">
      <img class="block h-7 w-auto" src="/logo.svg" alt="Tailboot" width="1238" height="409" />
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="https://github.com/ShoeBoom/tailboot" rel="noreferrer">GitHub</a>
        <span>Made with ❤️ by <a href="https://x.com/Shoeboom" rel="noreferrer" aria-label="@Shoeboom on X">@Shoeboom</a></span>
      </div>
    </header>

    <main class="mx-auto w-[min(100%-2.5rem,62rem)] pt-8 pb-16">
      <p class="mb-10 max-w-[44rem]">
        Tailboot is a Debian live image that boots headless and gives you SSH
        access through Tailscale, Tailcat, or both. It
        installs nothing else; add what you need over SSH.
      </p>

      <div class="grid gap-10 min-[56rem]:grid-cols-[minmax(0,1fr)_20rem] min-[56rem]:items-start min-[56rem]:gap-x-16">
        <section class="max-w-[40rem]" aria-labelledby="key-heading">
          <h2 id="key-heading" class="mb-[0.6rem] text-[1.05rem] font-bold">1. Choose how to connect</h2>
          <p class="mb-[0.85rem]">For Tailcat, enable it in the customizer to generate a random identity. No account is needed. Save the connection command before booting.</p>
          <h3 class="mb-[0.6rem] font-semibold">For Tailscale</h3>
          <p class="mb-[0.85rem]">
            In <a href="https://console.tailscale.com/admin/settings/keys" rel="noreferrer">Settings → Keys</a>,
            choose <strong>Generate auth key</strong>:
          </p>
          <table class="spec mb-[0.85rem] border-collapse">
            <tbody>
              <tr><th scope="row">Description</th><td><code>tailboot</code> (optional)</td></tr>
              <tr><th scope="row">Reusable</th><td>On</td></tr>
              <tr><th scope="row">Expiration</th><td>90 days</td></tr>
              <tr><th scope="row">Ephemeral</th><td>On</td></tr>
              <tr><th scope="row">Pre-approved</th><td>On, if shown</td></tr>
              <tr><th scope="row">Tags</th><td>An isolated tag such as <code>tag:isolated</code></td></tr>
            </tbody>
          </table>
          <p class="mb-[0.85rem]">
            Tagging is recommended. Define the tag in
            <a href="https://console.tailscale.com/admin/acls" rel="noreferrer">Access Controls</a>
            and write your policy so tagged machines cannot reach other
            devices while you can still reach them over Tailscale SSH. The
            tag alone restricts nothing; broad allow rules must exclude it.
            See <a href="https://tailscale.com/kb/1245/set-up-servers" rel="noreferrer">Set up servers</a>.
          </p>
          <p class="mb-[0.85rem] last:mb-0">
            Each boot registers a new ephemeral device. When the key
            expires, generate another and build a new ISO.
          </p>
        </section>

        <section class="max-w-[40rem] border border-line p-5 min-[56rem]:sticky min-[56rem]:top-5 min-[56rem]:col-start-2 min-[56rem]:row-span-3 min-[56rem]:row-start-1" aria-labelledby="create-heading">
          <h2 id="create-heading" class="mb-[0.6rem] text-[1.05rem] font-bold">2. Create the ISO</h2>
          <!-- Keep credentials outside a form so native submission is impossible. -->
          <div
            id="customizer"
            class="grid gap-[0.6rem]"
            data-iso-url={isoUrl}
            data-iso-name={isoName}
            data-config-offset={configOffset}
          >
            <p class="m-0 text-[0.9rem] text-muted">Configure at least one connection method.</p>
            <fieldset id="config-fields" class="m-0 grid min-w-0 gap-[0.6rem] border-0 p-0">
            <legend class="sr-only">Connection and network settings</legend>
            <label class="font-semibold" for="auth-key">Tailscale auth key (optional)</label>
            <input
              class="min-h-10 px-3 py-2"
              id="auth-key"
              type="password"
              autocomplete="off"
              spellcheck="false"
              placeholder="tskey-auth-…"
            />
            <label class="flex items-center gap-2 font-semibold" for="tailcat-enabled">
              <input id="tailcat-enabled" type="checkbox" /> Enable Tailcat
            </label>
            <div id="tailcat-settings" hidden>
              <div class="grid min-w-0 gap-[0.6rem]">
                <p class="m-0 text-[0.9rem] text-muted">A random identity is generated on your computer. Save the command below; anyone who has it can open a shell.</p>
                <label class="font-semibold" for="tailcat-command">Connection command</label>
                <textarea id="tailcat-command" class="w-full min-w-0 px-3 py-2 font-mono text-[0.8rem]" rows="5" readonly spellcheck="false" aria-describedby="tailcat-reuse"></textarea>
                <button id="tailcat-copy" class="min-h-10 px-3 py-2" type="button">Copy command</button>
                <button id="tailcat-generate" class="min-h-10 px-3 py-2" type="button">Generate new identity</button>
                <button id="tailcat-export" class="min-h-10 px-3 py-2" type="button">Save private key</button>
                <p id="tailcat-reuse" class="m-0 text-[0.9rem] text-muted">The identity works across reboots. Generate a separate identity and ISO for each machine used at the same time.</p>
                <details>
                  <summary class="cursor-pointer">Import an existing private key</summary>
                  <div class="mt-[0.6rem] grid gap-[0.6rem]">
                    <label for="tailcat-import">Paste the contents of a Tailcat .private.json file</label>
                    <textarea id="tailcat-import" class="w-full min-w-0 px-3 py-2" rows="4" autocomplete="off" spellcheck="false"></textarea>
                    <p class="m-0 text-[0.9rem] text-muted">Use a key saved here, or generated by Tailcat 0.6.0+ with <code>--region=301</code>. An address or memorable password cannot be used as a server key.</p>
                    <button id="tailcat-import-button" class="min-h-10 px-3 py-2" type="button">Import key</button>
                  </div>
                </details>
                <p id="tailcat-status" class="m-0 text-[0.9rem] text-muted" role="status" aria-live="polite"></p>
              </div>
            </div>
            <details>
              <summary class="cursor-pointer">Wi-Fi (optional)</summary>
              <div class="mt-[0.6rem] grid gap-[0.6rem]">
                <label class="font-semibold" for="wifi-ssid">Network name (SSID)</label>
                <input class="min-h-10 px-3 py-2" id="wifi-ssid" type="text" autocomplete="off" spellcheck="false" />
                <label class="font-semibold" for="wifi-password">Wi-Fi password</label>
                <input class="min-h-10 px-3 py-2" id="wifi-password" type="password" autocomplete="off" />
                <p class="m-0 border-0 p-0 text-[0.9rem] text-muted">WPA2/WPA3 Personal. Ethernet takes priority; Wi-Fi is the fallback. Leave the network name empty to use Ethernet only.</p>
              </div>
            </details>
            </fieldset>
            <button id="create-iso" class="min-h-10 px-3 py-2 disabled:cursor-not-allowed" type="button" disabled>Create ISO</button>
            <noscript>Enable JavaScript to customize an ISO in your browser.</noscript>
            <progress class="w-full" id="progress" hidden></progress>
            <p class="m-0 text-[0.9rem] text-muted" id="status" role="status" aria-live="polite">
              {isoUrl
                ? `Base image: ${release}`
                : "No release image configured."}
            </p>
          </div>
          <p class="mt-4 border-t border-line pt-4 text-[0.9rem] text-muted">
            Credentials are written into the ISO in your browser and are not
            uploaded. The resulting image contains them in plain text; keep
            it private.
          </p>
        </section>

        <section class="max-w-[40rem]" aria-labelledby="boot-heading">
          <h2 id="boot-heading" class="mb-[0.6rem] text-[1.05rem] font-bold">3. Flash and boot</h2>
          <p class="mb-[0.85rem] last:mb-0">
            Write the ISO to a USB drive with <code>dd</code>, Etcher, or
            similar and boot from it on a machine with Ethernet or the Wi-Fi
            network you configured. No display or keyboard is needed. The
            Tailscale machine appears in your tailnet as <code>tailboot</code>; if that
            name is taken, Tailscale appends a number (<code>tailboot-1</code>).
          </p>
        </section>

        <section class="max-w-[40rem]" aria-labelledby="ssh-heading">
          <h2 id="ssh-heading" class="mb-[0.6rem] text-[1.05rem] font-bold">4. Connect</h2>
          <p class="mb-[0.85rem]">For Tailcat, install <a href="https://github.com/tailscale/tailcat#install" rel="noreferrer">Tailcat 0.6.0 or newer</a> on your computer and run the saved connection command. Use <code>sudo -i</code> for root access.</p>
          <p class="mb-[0.85rem]">For Tailscale:</p>
          <pre class="mb-[0.85rem] overflow-x-auto border border-line px-4 py-3"><code>ssh tailboot@tailboot
sudo -i</code></pre>
          <p class="mb-[0.85rem]">
            Tailscale authenticates the session; there is no password. Your
            policy must allow port 22 to the machine and include an SSH rule
            for the <code>tailboot</code> user. <code>autogroup:nonroot</code>
            covers it; <code>root</code> is not included. See
            <a href="https://tailscale.com/kb/1193/tailscale-ssh" rel="noreferrer">Tailscale SSH</a>.
          </p>
          <p class="mb-[0.85rem] last:mb-0">
            The local console logs in as <code>tailboot</code> automatically.
            If it prompts, the password is <code>live</code>. The account has
            passwordless sudo.
          </p>
        </section>
      </div>

      <section class="mt-12 max-w-[40rem] border-t border-line pt-8" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="mb-4 text-[1.75rem] font-bold">FAQ</h2>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">Does the website send my credentials to a server?</h3>
        <p class="mb-[0.85rem]">
          No. The website is a static page on GitHub Pages. It has no
          backend. Your browser generates or imports your Tailcat key, downloads
          the base ISO, and writes your credentials into it locally. Credentials
          are not uploaded.
        </p>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">How does the browser change the ISO?</h3>
        <p class="mb-[0.85rem]">
          The base ISO has a file <code>/TAILBOOT.JSON</code> with a
          reserved 4096-byte placeholder. Your browser reads the ISO as a
          stream and replaces the placeholder at the byte offset recorded
          during the release build with your settings as JSON. The JSON is
          padded with spaces to the same size. Nothing
          else in the ISO moves. The file is outside the compressed live
          system, so the replacement does not damage the filesystem. See
          <a href="https://github.com/ShoeBoom/tailboot/blob/main/tailboot-iso.ts" rel="noreferrer"><code>tailboot-iso.ts</code></a>.
        </p>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">How does the machine use the key?</h3>
        <p class="mb-[0.85rem]">
          At boot, a service reads <code>/TAILBOOT.JSON</code> from the boot
          medium and starts the connection methods you configured. Runtime
          credentials stay in memory. Tailscale registers a new ephemeral
          device each boot; Tailcat reuses the identity embedded in the ISO. See
          <a href="https://github.com/ShoeBoom/tailboot/tree/main/image/config/includes.chroot" rel="noreferrer">the boot scripts</a>.
        </p>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">How can I check this?</h3>
        <p class="mb-[0.85rem]">
          All code is open source at
          <a href="https://github.com/ShoeBoom/tailboot" rel="noreferrer">github.com/ShoeBoom/tailboot</a>.
          Open the network panel of your browser before you create an ISO.
          You will see one request to the proxy for the base ISO and no
          request that contains your key. Mount the ISO you made and read
          <code>TAILBOOT.JSON</code> to see the data it contains.
        </p>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">Can I make the ISO without the website?</h3>
        <p class="mb-[0.85rem]">
          For Tailscale, download the command-line tool from
          <a href="https://github.com/ShoeBoom/tailboot/releases" rel="noreferrer">GitHub releases</a>.
          Use the website to configure Tailcat.
        </p>

        <h3 class="mt-5 mb-[0.4rem] text-base font-bold">Why must I restrict the key with a tag?</h3>
        <p class="mb-[0.85rem] last:mb-0">
          The ISO contains the key in plain text. A person who has the USB
          drive can read the key. Restrict the key to an isolated tag so a
          machine that boots the ISO cannot reach other devices in your
          tailnet.
        </p>
      </section>
    </main>

    <script>
      import { patchTailbootIso } from "../../../tailboot-iso.ts";
      import { validateTailbootConfig } from "../../../tailboot-config.ts";
      import { generateTailcatKey, importTailcatKey, tailcatAddress, type TailcatKey } from "../../../tailcat.ts";

      type SaveFilePicker = (options: {
        suggestedName: string;
        types: Array<{
          description: string;
          accept: Record<string, string[]>;
        }>;
      }) => Promise<{
        createWritable: () => Promise<WritableStream<Uint8Array>>;
      }>;

      const customizer = document.querySelector<HTMLDivElement>("#customizer")!;
      const keyInput = document.querySelector<HTMLInputElement>("#auth-key")!;
      const ssidInput = document.querySelector<HTMLInputElement>("#wifi-ssid")!;
      const passwordInput = document.querySelector<HTMLInputElement>("#wifi-password")!;
      const button = document.querySelector<HTMLButtonElement>("#create-iso")!;
      const fields = document.querySelector<HTMLFieldSetElement>("#config-fields")!;
      const tailcatEnabled = document.querySelector<HTMLInputElement>("#tailcat-enabled")!;
      const tailcatSettings = document.querySelector<HTMLDivElement>("#tailcat-settings")!;
      const tailcatCommand = document.querySelector<HTMLTextAreaElement>("#tailcat-command")!;
      const tailcatImport = document.querySelector<HTMLTextAreaElement>("#tailcat-import")!;
      const tailcatStatus = document.querySelector<HTMLParagraphElement>("#tailcat-status")!;
      let tailcat: TailcatKey | undefined;

      function showTailcatKey(key: TailcatKey) {
        tailcat = key;
        tailcatCommand.value = `tailcat ssh ${tailcatAddress(key)}`;
      }

      function generateIdentity() {
        try {
          showTailcatKey(generateTailcatKey());
          tailcatStatus.textContent = "New identity generated. Save its connection command.";
        } catch {
          tailcatStatus.textContent = "Secure key generation failed. Use a browser with secure random-number support.";
        }
      }

      tailcatEnabled.addEventListener("change", () => {
        tailcatSettings.hidden = !tailcatEnabled.checked;
        if (tailcatEnabled.checked) generateIdentity();
        else {
          tailcat = undefined;
          tailcatCommand.value = "";
          tailcatImport.value = "";
        }
      });
      document.querySelector("#tailcat-generate")!.addEventListener("click", generateIdentity);
      document.querySelector("#tailcat-import-button")!.addEventListener("click", () => {
        try {
          showTailcatKey(importTailcatKey(tailcatImport.value));
          tailcatImport.value = "";
          tailcatStatus.textContent = "Identity imported. Save its connection command.";
        } catch (error) {
          tailcatStatus.textContent = error instanceof Error ? error.message : "Could not import the key.";
        }
      });
      document.querySelector("#tailcat-copy")!.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(tailcatCommand.value);
          tailcatStatus.textContent = "Connection command copied. Keep it private.";
        } catch {
          tailcatCommand.select();
          tailcatStatus.textContent = "Select and copy the connection command above.";
        }
      });
      document.querySelector("#tailcat-export")!.addEventListener("click", () => {
        if (!tailcat) return;
        const url = URL.createObjectURL(new Blob([JSON.stringify(tailcat, null, 2)], { type: "application/json" }));
        const link = document.createElement("a");
        link.href = url;
        link.download = "tailboot.private.json";
        link.click();
        window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
        tailcatStatus.textContent = "Private key saved. Keep it private with your ISO.";
      });
      const progress = document.querySelector<HTMLProgressElement>("#progress")!;
      const status = document.querySelector<HTMLParagraphElement>("#status")!;
      const pickFile = (window as Window & { showSaveFilePicker?: SaveFilePicker })
        .showSaveFilePicker;

      button.disabled = !customizer.dataset.isoUrl;
      ssidInput.addEventListener("input", () => {
        passwordInput.required = ssidInput.value.length > 0;
      });

      button.addEventListener("click", async () => {
        const isoUrl = customizer.dataset.isoUrl;
        if (!isoUrl || button.disabled) return;
        passwordInput.required = ssidInput.value.length > 0;
        if (!passwordInput.reportValidity()) return;
        const settings = {
          tailcat,
          authKey: keyInput.value,
          ...(ssidInput.value ? {
            wifi: { ssid: ssidInput.value, password: passwordInput.value },
          } : {}),
        };

        let config;
        try {
          if (tailcatEnabled.checked && !tailcat) throw new Error("Generate or import a Tailcat identity first.");
          config = validateTailbootConfig(settings);
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "Configure a connection method.";
          return;
        }
        fields.disabled = true;
        button.disabled = true;
        progress.hidden = false;
        progress.removeAttribute("value");
        const download = new AbortController();

        try {
          const fileName = (customizer.dataset.isoName ?? "tailboot.iso").replace(
            /\.iso$/,
            "-custom.iso",
          );
          const handle = pickFile
            ? await pickFile.call(window, {
                suggestedName: fileName,
                types: [
                  {
                    description: "Tailboot ISO",
                    accept: { "application/x-iso9660-image": [".iso"] },
                  },
                ],
              })
            : undefined;

          status.textContent = handle
            ? "Downloading and customizing…"
            : "Downloading and customizing in memory… Keep this tab open.";
          const source = await fetch(isoUrl, {
            signal: download.signal,
            credentials: "omit",
          });
          if (source.status !== 200 || !source.body) {
            throw new Error(`ISO download failed with HTTP ${source.status}.`);
          }
          const downloadSize = Number(source.headers.get("Content-Length"));
          if (downloadSize > 0) {
            progress.max = downloadSize;
            progress.value = 0;
          }

          const chunks: ArrayBuffer[] = [];
          const destination = handle
            ? await handle.createWritable()
            : new WritableStream<Uint8Array>({
                write(chunk) {
                  const copy = new Uint8Array(chunk.byteLength);
                  copy.set(chunk);
                  chunks.push(copy.buffer);
                },
              });
          await patchTailbootIso({
            source: source.body,
            configOffset: Number(customizer.dataset.configOffset),
            config,
            destination,
            onProgress: (inputBytes) => {
              if (downloadSize > 0) progress.value = inputBytes;
            },
          });

          if (!handle) {
            const downloadUrl = URL.createObjectURL(
              new Blob(chunks, { type: "application/x-iso9660-image" }),
            );
            const link = document.createElement("a");
            link.href = downloadUrl;
            link.download = fileName;
            link.hidden = true;
            document.body.append(link);
            link.click();
            link.remove();
            window.setTimeout(() => URL.revokeObjectURL(downloadUrl), 60_000);
          }

          keyInput.value = "";
          passwordInput.value = "";
          progress.max = 1;
          progress.value = 1;
          status.textContent = "ISO ready. Flash it to a USB drive.";
        } catch (error) {
          progress.hidden = true;
          status.textContent = error instanceof DOMException && error.name === "AbortError"
            ? "Customization cancelled."
            : error instanceof Error
              ? error.message
              : "Could not create the ISO.";
        } finally {
          download.abort();
          button.disabled = false;
          fields.disabled = false;
        }
      });
    </script>
  </body>
</html>
