---
import iconUrl from "../../icon.svg?url";
import { getRelease } from "../../release.ts";

const release = import.meta.env.DEV ? null : getRelease(process.env);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Create a Tailboot live ISO with Tailscale SSH enabled."
    />
    <link rel="icon" href={iconUrl} type="image/svg+xml" />
    <title>Tailboot</title>
  </head>
  <body>
    <main>
      <h1>Tailboot</h1>
      <p>
        Create a headless Debian live USB that joins your tailnet and accepts
        Tailscale SSH connections.
      </p>

      <form
        id="customizer"
        data-iso-url={release?.isoUrl}
        data-iso-name={release?.isoName}
        data-iso-size={release?.size}
      >
        <label for="auth-key">Tailscale auth key</label>
        <input
          id="auth-key"
          type="password"
          autocomplete="off"
          spellcheck="false"
          placeholder="tskey-auth-…"
        />
        <button type="submit" disabled>Create ISO</button>
        <noscript>Enable JavaScript to customize an ISO in your browser.</noscript>
        <progress id="progress" hidden></progress>
        <p id="status" role="status" aria-live="polite">
          {release
            ? `Base image: ${release.tag}`
            : "No release image configured."}
        </p>
      </form>

      <p class="note">
        The key is inserted locally in your browser. The customized ISO contains
        it in plain text, so keep the image private.
      </p>
    </main>

    <script>
      import { patchTailbootIso } from "../tailboot-iso.ts";

      type SaveFilePicker = (options: {
        suggestedName: string;
        types: Array<{
          description: string;
          accept: Record<string, string[]>;
        }>;
      }) => Promise<{
        createWritable: () => Promise<WritableStream<Uint8Array>>;
      }>;

      const form = document.querySelector<HTMLFormElement>("#customizer")!;
      const keyInput = document.querySelector<HTMLInputElement>("#auth-key")!;
      const button = document.querySelector<HTMLButtonElement>("button")!;
      const progress = document.querySelector<HTMLProgressElement>("#progress")!;
      const status = document.querySelector<HTMLParagraphElement>("#status")!;
      const pickFile = (window as Window & { showSaveFilePicker?: SaveFilePicker })
        .showSaveFilePicker;

      button.disabled = !form.dataset.isoUrl;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const isoUrl = form.dataset.isoUrl;
        if (!isoUrl || button.disabled) return;
        const accessKey = keyInput.value;
        const expectedSize = Number(form.dataset.isoSize);

        button.disabled = true;
        progress.hidden = false;
        progress.max = expectedSize;
        progress.value = 0;
        const download = new AbortController();

        try {
          const fileName = (form.dataset.isoName ?? "tailboot.iso").replace(
            /\.iso$/,
            "-custom.iso",
          );
          const handle = pickFile
            ? await pickFile.call(window, {
                suggestedName: fileName,
                types: [
                  {
                    description: "Tailboot ISO",
                    accept: { "application/x-iso9660-image": [".iso"] },
                  },
                ],
              })
            : undefined;

          status.textContent = handle
            ? "Downloading and customizing…"
            : "Downloading and customizing in memory… Keep this tab open.";
          const source = await fetch(isoUrl, {
            signal: download.signal,
            credentials: "omit",
          });
          if (source.status !== 200 || !source.body) {
            throw new Error(`ISO download failed with HTTP ${source.status}.`);
          }

          const chunks: ArrayBuffer[] = [];
          const destination = handle
            ? await handle.createWritable()
            : new WritableStream<Uint8Array>({
                write(chunk) {
                  const copy = new Uint8Array(chunk.byteLength);
                  copy.set(chunk);
                  chunks.push(copy.buffer);
                },
              });
          await patchTailbootIso({
            source: source.body,
            expectedSize,
            accessKey,
            destination,
            onProgress: (inputBytes) => (progress.value = inputBytes),
          });

          if (!handle) {
            const downloadUrl = URL.createObjectURL(
              new Blob(chunks, { type: "application/x-iso9660-image" }),
            );
            const link = document.createElement("a");
            link.href = downloadUrl;
            link.download = fileName;
            link.hidden = true;
            document.body.append(link);
            link.click();
            link.remove();
            window.setTimeout(() => URL.revokeObjectURL(downloadUrl), 60_000);
          }

          keyInput.value = "";
          if (progress.max > 0) progress.value = progress.max;
          status.textContent = "ISO ready. Flash it to a USB drive.";
        } catch (error) {
          progress.hidden = true;
          status.textContent = error instanceof DOMException && error.name === "AbortError"
            ? "Customization cancelled."
            : error instanceof Error
              ? error.message
              : "Could not create the ISO.";
        } finally {
          download.abort();
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: #f4f5f7;
    color: #17191c;
    font-family: system-ui, sans-serif;
  }

  main {
    width: min(100%, 34rem);
    padding: 2rem;
    background: white;
    border: 1px solid #d9dce1;
    border-radius: 0.75rem;
  }

  h1 {
    margin: 0 0 0.5rem;
  }

  form {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  label {
    font-weight: 650;
  }

  input,
  button {
    min-height: 2.75rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid #aeb4bd;
    border-radius: 0.4rem;
    font: inherit;
  }

  button {
    border-color: #111827;
    background: #111827;
    color: white;
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  progress {
    width: 100%;
  }

  #status,
  .note {
    margin: 0;
    color: #565d68;
    font-size: 0.9rem;
  }

  .note {
    margin-top: 1.5rem;
  }
</style>
