[Unit]
Description=Join Tailscale and enable Tailscale SSH
# Restart on failure handles late connectivity; do not wait for Wi-Fi scans.
After=tailscaled.service tailboot-configure.service
Requires=tailscaled.service tailboot-configure.service

[Service]
Type=oneshot
ExecStart=/usr/bin/tailscale up --auth-key=file:/run/tailboot/auth.key --ssh --timeout=2m
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
