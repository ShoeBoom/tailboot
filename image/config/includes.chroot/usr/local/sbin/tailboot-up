#!/bin/sh

set -eu

record=/run/live/medium/TAILBOOT.KEY
key=$(sed -n '2p' "${record}" | sed 's/[[:space:]]*$//')

if [ -z "${key}" ] || printf '%s' "${key}" | grep -q '~'; then
  logger -t tailboot "No Tailscale auth key is embedded in this image"
  exit 0
fi

if ! printf '%s\n' "${key}" | LC_ALL=C grep -q '^[!-~]\+$'; then
  logger -t tailboot "The embedded Tailscale auth key is malformed"
  exit 1
fi

umask 077
auth_file=$(mktemp /run/tailboot-auth-key.XXXXXX)
trap 'rm -f "${auth_file}"' EXIT HUP INT TERM
printf '%s\n' "${key}" > "${auth_file}"
unset key

# file: keeps the credential out of the process command line.
tailscale up --auth-key="file:${auth_file}" --ssh --timeout=2m
logger -t tailboot "Tailscale SSH is ready"

